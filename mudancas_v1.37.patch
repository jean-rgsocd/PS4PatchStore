+/* ---- desenho */
+static void pl_blit_center(UI *ui, const Image *im, int x, int y, int w, int h) {
+  if (!im) return;
+  gfx_blit(ui->s, im, x + (w - im->w) / 2, y + (h - im->h) / 2, 0, 255);
+}
